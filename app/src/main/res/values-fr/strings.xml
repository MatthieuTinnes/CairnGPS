    <string name="constellation_gps_desc">Le système historique, couverture mondiale. La bande L5 améliore la précision en montagne et en canyon urbain.</string>

    <string name="constellation_glonass_region">Russie</string>
    <string name="constellation_glonass_stats">24 satellites · MEO 19 130 km · L1OF, L2OF</string>
    <string name="constellation_glonass_desc">Orbites très inclinées : meilleure visibilité aux latitudes élevées, utile en haute montagne nordique.</string>

    <string name="constellation_galileo_region">Union européenne</string>
    <string name="constellation_galileo_stats">28 satellites · MEO 23 222 km · E1, E5a, E5b</string>
    <string name="constellation_galileo_desc">Le plus précis en usage civil (&lt; 1 m avec E5). Service de retour de détresse intégré.</string>

    <string name="constellation_beidou_region">Chine</string>
    <string name="constellation_beidou_stats">44 satellites · MEO + IGSO + GEO · B1, B2, B3</string>
    <string name="constellation_beidou_desc">Constellation hybride : des satellites géostationnaires complètent la couverture en Asie-Pacifique.</string>

    <string name="constellation_qzss_region">Japon</string>
    <string name="constellation_qzss_stats">4 satellites · orbite quasi-zénithale · L1, L2, L5, L6</string>
    <string name="constellation_qzss_desc">Régional : passe près du zénith au-dessus du Japon, fiabilise le fix entre les immeubles et les vallées.</string>

    <string name="constellation_irnss_region">Inde</string>
    <string name="constellation_irnss_stats">7 satellites · GEO + GSO 35 786 km · L5, bande S</string>
    <string name="constellation_irnss_desc">Système régional (NavIC) couvrant l\'Inde et environ 1 500 km autour. Orbites géosynchrones : couverture constante au zénith.</string>

