    <!-- Constellation info page -->
    <string name="action_open_constellation_info">Constellations</string>
    <string name="constellation_info_title">GNSS constellations</string>
    <string name="constellation_info_intro">A GNSS receiver combines signals from several satellite constellations to compute your position. The more systems are visible, the better the accuracy and time to fix.</string>

    <string name="constellation_gps_region">United States</string>
    <string name="constellation_gps_stats">31 satellites · MEO 20,180 km · L1 C/A, L2C, L5</string>
    <string name="constellation_gps_desc">The historic system, with worldwide coverage. The L5 band improves accuracy in mountains and urban canyons.</string>

    <string name="constellation_glonass_region">Russia</string>
    <string name="constellation_glonass_stats">24 satellites · MEO 19,130 km · L1OF, L2OF</string>
    <string name="constellation_glonass_desc">Highly inclined orbits: better visibility at high latitudes, useful in northern high mountains.</string>

    <string name="constellation_galileo_region">European Union</string>
    <string name="constellation_galileo_stats">28 satellites · MEO 23,222 km · E1, E5a, E5b</string>
    <string name="constellation_galileo_desc">The most accurate for civilian use (&lt; 1 m with E5). Built-in distress return service.</string>

    <string name="constellation_beidou_region">China</string>
    <string name="constellation_beidou_stats">44 satellites · MEO + IGSO + GEO · B1, B2, B3</string>
    <string name="constellation_beidou_desc">Hybrid constellation: geostationary satellites supplement coverage across Asia-Pacific.</string>

    <string name="constellation_qzss_region">Japan</string>
    <string name="constellation_qzss_stats">4 satellites · quasi-zenith orbit · L1, L2, L5, L6</string>
    <string name="constellation_qzss_desc">Regional: passes near the zenith over Japan, improving fix reliability between buildings and valleys.</string>

